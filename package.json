{
  "name": "tributejs-ng",
  "version": "5.2.4",
  "description": "Cross-browser @mention and autocomplete engine",
  "main": "dist/tribute.js",
  "module": "dist/tribute.esm.js",
  "browser": "dist/tribute.min.js",
  "types": "tributejs.d.ts",
  "files": [
    "dist",
    "tribute.css",
    "tributejs.d.ts"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "babel-plugin-add-module-exports": "^1.0.2",
    "babelify": "^10.0.0",
    "browserify": "^17.0.1",
    "jasmine-core": "^7.0.2",
    "karma": "^6.4.4",
    "karma-browserify": "^8.1.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "karma-spec-reporter": "^0.0.36",
    "rollup": "^4.63.1",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-sass": "^1.16.0-rc.1",
    "rollup-plugin-serve": "^3.0.0",
    "watchify": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valentinstn/tributejs-ng.git"
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "start": "rollup -c rollup.config.mjs -w",
    "test": "karma start test/karma.conf.js",
    "test-single-run": "karma start test/karma.conf.js --single-run --browsers ChromeHeadless"
